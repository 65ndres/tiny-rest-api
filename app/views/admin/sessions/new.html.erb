<section class="auth-card">
  <h1>Support login</h1>

  <%= form_with url: admin_login_path, method: :post, local: true, class: 'stack' do %>
    <label>
      Email
      <input type="email" name="email" required autocomplete="username" value="<%= params[:email] %>">
    </label>
    <label>
      Password
      <input type="password" name="password" required autocomplete="current-password">
    </label>
    <button type="submit" class="btn btn-primary">Sign in</button>
  <% end %>
</section>
